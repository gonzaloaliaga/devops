server {
    listen 80;
    
    # 1. Servir los archivos de React/Vite
    location / {
        root   /usr/share/nginx/html;
        index  index.html index.htm;
        try_files $uri $uri/ /index.html;
    }

    # 2. Proxy inverso para el Backend de Ventas
    location /api/v1/ventas {
        proxy_pass http://${BACKEND_VENTAS_IP}:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # 3. Proxy inverso para el Backend de Despachos
    location /api/v1/despachos {
        proxy_pass http://${BACKEND_DESPACHOS_IP};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
}