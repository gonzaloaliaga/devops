server {
    listen 80;
    
    # 1. Servir los archivos estáticos de la aplicación React/Vite
    location / {
        root   /usr/share/nginx/html;
        index  index.html index.htm;
        try_files $uri $uri/ /index.html;
    }

    # 2. Redirigir peticiones de Ventas a su respectiva EC2 (Puerto 8080)
    location /api/v1/ventas {
        proxy_pass http://${BACKEND_VENTAS_IP}:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # 3. Redirigir peticiones de Despachos a su respectiva EC2 (Puerto 8081)
    location /api/v1/despachos {
        proxy_pass http://${BACKEND_DESPACHOS_IP}:8081;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}